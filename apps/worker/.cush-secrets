SMTP_USER = { ref = "op://cush/hexi-photo-gallery-worker/smtp_user", target_vault = "cush", target_item = "hexi-photo-gallery-worker" }
SMTP_FROM = { ref = "op://cush/hexi-photo-gallery-worker/smtp_from", target_vault = "cush", target_item = "hexi-photo-gallery-worker" }
SMTP_PASS = { ref = "op://cush/hexi-photo-gallery-worker/smtp_pass", target_vault = "cush", target_item = "hexi-photo-gallery-worker" }
MAGIC_LINK_BASE_URL = { ref = "op://cush/hexi-photo-gallery-worker/magic_link_base_url", target_vault = "cush", target_item = "hexi-photo-gallery-worker" }
